# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: paste locally only, never commit or share
SUPABASE_SERVICE_ROLE_KEY=

# Public site address. Vercel subdomain for now; change here when the domain is bought.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email: "gmail" until a domain exists, then "resend"
EMAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=

# AI production planning (Gemini) – server only, never NEXT_PUBLIC_
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.8-flash)
GEMINI_MODEL=
# Optional: models to try when the main one is overloaded (default: gemini-3.6-flash,gemini-3.5-flash-lite)
GEMINI_FALLBACK_MODELS=4567
